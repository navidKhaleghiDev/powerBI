# PostgreSQL configuration
POSTGRES_DB=bi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Kafka Connect REST API, reachable from Django (optional)
KAFKA_CONNECT_URL=http://localhost:8083

# Debezium UI proxy for connector configuration (cluster 1)
DEBEZIUM_UI_URL=http://localhost:8080

# ClickHouse HTTP connection used to provision CDC pipelines
CONSUMER_HOST=localhost
CONSUMER_PORT=8123
CONSUMER_USER=bi
CONSUMER_PASSWORD=clickhouse
CONSUMER_DATABASE=financial_analytics
# Broker address reachable from the ClickHouse container
CLICKHOUSE_KAFKA_BROKERS=kafka:29092

# Separate PostgreSQL service `db` used only by Django in Compose.
# These initialize the database on the first start with an empty data volume.
DJANGO_POSTGRES_DB=bi
DJANGO_POSTGRES_USER=bi
DJANGO_POSTGRES_PASSWORD=bi

# Optional separate read-only ClickHouse credentials for dashboard queries.
# If omitted, the CONSUMER_* credentials are used with read-only query settings.
# ANALYTICS_USER=analytics_reader
# ANALYTICS_PASSWORD=replace-with-reader-password
